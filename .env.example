# Optional release overrides. The default is the actual ZIP in release/windows/.
VITE_GAME_VERSION=1.0.0
VITE_WINDOWS_DOWNLOAD_URL=/downloads/DontLookBehindYou-Windows-v1.0.0.zip

# The ZIP size and SHA-256 are calculated automatically from the package at build time.
# Set VITE_WINDOWS_FILE_SIZE only if the download URL points to a separately hosted archive.
# VITE_WINDOWS_FILE_SIZE=

# Optional official social/contact links. Leave blank until these exist.
VITE_INSTAGRAM_URL=
VITE_TWITTER_URL=
VITE_YOUTUBE_URL=
VITE_CONTACT_EMAIL=
