# Optional release overrides. The defaults are the actual archives in release/.
VITE_GAME_VERSION=1.0.0
VITE_WINDOWS_DOWNLOAD_URL=/downloads/DontLookBehindYou-Windows-v1.0.0.zip
VITE_ANDROID_DOWNLOAD_URL=/downloads/DontLookBehindYou-Android-v1.0.0.apk

# Set this only when a working browser-ready Ren'Py Web build is deployed.
# VITE_RENPY_WEB_URL=https://files.example.com/renpy-web/index.html

# Sizes and SHA-256 values are calculated automatically from the release archives.
# Set these only if a download URL points to a separately hosted archive.
# VITE_WINDOWS_FILE_SIZE=
# VITE_ANDROID_FILE_SIZE=

# Optional official social/contact links. Leave blank until these exist.
VITE_INSTAGRAM_URL=
VITE_TWITTER_URL=
VITE_YOUTUBE_URL=
VITE_CONTACT_EMAIL=
